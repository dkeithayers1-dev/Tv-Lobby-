# --- Core ---------------------------------------------------------------
FLASK_SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me            # protects the dashboard; leave blank only for local testing
PUBLIC_BASE_URL=                     # e.g. https://leads.yourbusiness.com (used in links sent to customers)
# DATABASE_PATH=instance/leadpilot.db

# --- AI brain (Claude). Without a key the built-in rules engine is used. --
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=rules                  # force the offline rules engine

# --- Twilio: SMS, WhatsApp and phone calls ------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15551234567
TWILIO_WHATSAPP_FROM=+14155238886
TEAM_FORWARD_NUMBER=                 # ring this phone first during business hours; AI answers if no one picks up

# --- Email (SMTP) --------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Team alerts (handoffs, replies, new leads) --------------------------
TEAM_ALERT_PHONE=
TEAM_ALERT_EMAIL=

# --- Lead intake API / generic webhooks (X-API-Key header) ---------------
LEAD_API_KEY=
