# Copy this file to .env and fill in your own values. Never commit .env.

# SMTP server used to send the updated expense report by email.
# Gmail example: smtp.gmail.com / 587, with an App Password (not your normal
# Gmail password) generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=dkeithayers1@gmail.com
SMTP_PASSWORD=your-app-password

# Who the report appears to come from, and who receives it.
# MAIL_TO accepts a comma-separated list for multiple recipients.
MAIL_FROM=dkeithayers1@gmail.com
MAIL_TO=dkeithayers1@gmail.com,keith.ayers@ssmgrp.com

# Optional: change the Flask secret key and port used for local dev.
FLASK_SECRET_KEY=change-me
PORT=5000
