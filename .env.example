# Copy this file to .env and fill in your own values. Never commit .env.

# SMTP server used to send the updated expense report by email.
# Gmail example: smtp.gmail.com / 587, with an App Password (not your normal
# Gmail password) generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=dkeithayers1@gmail.com
SMTP_PASSWORD=your-app-password

# Who the report appears to come from, and who receives it.
# MAIL_TO accepts a comma-separated list for multiple recipients.
MAIL_FROM=dkeithayers1@gmail.com
MAIL_TO=dkeithayers1@gmail.com,keith.ayers@ssmgrp.com

# Optional: change the Flask secret key and port used for local dev.
FLASK_SECRET_KEY=change-me
PORT=5000

# Best Fit Senior Placement. Generate a real Fernet key; do not commit it.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BESTFIT_SECRET_KEY=change-me-to-a-long-random-string
BESTFIT_DATA_KEY=
BESTFIT_ADMIN_EMAIL=
BESTFIT_ADMIN_PASSWORD=
BESTFIT_ADMIN_NAME=Administrator
BESTFIT_PORT=5050
# Set to 1 behind HTTPS so the session cookie is marked Secure.
BESTFIT_COOKIE_SECURE=
# Set to 1 to resolve street addresses on the server (cached, one request per second).
BESTFIT_NOMINATIM=
