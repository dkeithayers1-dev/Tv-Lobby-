# Copy this file to .env and fill in your own values. Never commit .env.

# SMTP server used to send the updated expense report by email.
# Gmail example: smtp.gmail.com / 587, with an App Password (not your normal
# Gmail password) generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=dkeithayers1@gmail.com
SMTP_PASSWORD=your-app-password

# Who the report appears to come from, and who receives it.
# MAIL_TO accepts a comma-separated list for multiple recipients.
MAIL_FROM=dkeithayers1@gmail.com
MAIL_TO=dkeithayers1@gmail.com,keith.ayers@ssmgrp.com

# Administrator login for /schedule. Only the admin can change the schedule
# or text it out; everyone else can only view it. Pick a strong password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Signs the admin login cookie. Set this to a long random value, e.g. the
# output of: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me

# Optional: change the port used for local dev.
PORT=5000

# Twilio, used to text employees their schedule from /schedule.
# Find the SID and auth token at https://console.twilio.com, and use a
# Twilio phone number you own (E.164 format, e.g. +14805551234).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15555555555
